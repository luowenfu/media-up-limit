# 统一缩进、编码和换行符
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[{Dockerfile,Dockerfile.*,*.dockerfile}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2
end_of_line = lf

[*.md]
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf
indent_size = 4

[Makefile]
indent_style = tab
